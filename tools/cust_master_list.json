{
  "_meta": {
    "description": "Horizon OC CustomizeTable (CUST) master field list. All offsets are byte offsets from the start of the 4-byte 'CUST' magic signature (0x43555354) in the hoc.kip binary. All values are stored as little-endian uint32 unless noted. Edit the 'value' fields to your desired settings, then run patch_cust.py.",
    "cust_magic": "0x43555354",
    "cust_rev": 2,
    "source": "Horizon-OC customize.hpp / customize.cpp",
    "special_constants": {
      "AUTO": 0,
      "ENABLED": 1,
      "DISABLED": 0,
      "DEACTIVATED_GPU_FREQ": 2000,
      "CPU_MAX_MAX_VOLT": 1200000,
      "GPU_MIN_MIN_VOLT": 480000
    }
  },
  "header": {
    "cust_magic": {
      "offset": 0, "size": 4, "type": "magic", "read_only": true,
      "description": "Magic bytes 'CUST' — never modify.",
      "default_hex": "43555354"
    },
    "custRev": {
      "offset": 4, "size": 4, "type": "u32", "read_only": true,
      "description": "CUST revision number. Must be 2 for this HOC version.",
      "default": 2
    },
    "placeholder": {
      "offset": 8, "size": 4, "type": "u32", "read_only": true,
      "description": "Unused padding word.",
      "default": 0
    },
    "hpMode": {
      "offset": 12, "size": 4, "type": "u32",
      "description": "High-performance RAM mode — disables RAM power-down. 0=DISABLED, 1=ENABLED.",
      "default": 0,
      "value": 0,
      "toolkit_ini_key": "HP Mode",
      "allowed_values": [0, 1]
    }
  },
  "ram_emc_shared": {
